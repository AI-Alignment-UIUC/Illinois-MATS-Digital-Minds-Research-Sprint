{
  "model_name": "Qwen3.5-4B",
  "model_path": "data/models/Qwen3.5-4B",
  "documents_path": "data/documents/short_documents.jsonl",
  "lens_dir": "artifacts/jlenses/Qwen3.5-4B",
  "init_adapter": "artifacts/runs/qwen_lobotomy_reversal/adapter",
  "optim": {
    "num_steps": 100,
    "num_prompts": 64,
    "group_size": 32,
    "max_new_tokens": 512,
    "temperature": 1.0,
    "enable_thinking": true,
    "layer_range": [
      14,
      26
    ],
    "format_penalty": -1.0,
    "min_think_tokens": 40,
    "lora_rank": 8,
    "lora_alpha": 16,
    "lora_target_modules": [
      "gate_proj",
      "up_proj",
      "down_proj"
    ],
    "lr": 4e-05,
    "adam_betas": [
      0.8,
      0.95
    ],
    "max_grad_norm": 1.0,
    "micro_batch_size": 64,
    "dtype": "bfloat16",
    "seed": 0
  },
  "run": {
    "name": "verbalizer_qwen_rl_final",
    "train_gpu": 6,
    "inference_gpu": 7,
    "sglang_port": 30014,
    "logging": {
      "plot_every": 1,
      "sample_every": 10,
      "checkpoint_every": 25
    }
  }
}